{% extends '_site/layout.twig' %}

{% set breadcrumbs = [
    craft.entries.section('newsOverview').one(),
    entry,
] %}

{% block content %}
{% cache unless currentUser or craft.app.request.isPreview() %}

    {% embed "_site/components/pageHeader/default.twig" with { headerVariant: 'split', headerImageWidth: 'full' } %}
        {% block afterTitle %}
            <div class="mb-5 text-sm font-semibold text-gray-700">{{ entry.postDate|date('news.entry.dateFormat'|t("website_name")) }}</div>
        {% endblock %}
    {% endembed %}

     {% include '_site/contentBuilder/contentBuilder.twig'
        with {
        settings : {
            section: 'section',
            container: 'container',
        }
    } %}

    <div class="section section--default">
        <div class="container">
            <div class="flex gap-2 items-center text-lg font-semibold bg-light p-4">
                <div class="">{{ 'news.entry.shareThisArticle'|t('website_name') }}: </div>
                <div class="text-xl">
                    {% include '_site/components/socialShare.twig' %}
                </div>
            </div>
        </div>
    </div>

    {# Related news on every news item: the same overview as the Overview column, filled with the newest news in the same
       category (the first relation of the news source in config/overview-sources.php), then the newest others #}
    {% set newsSource = craft.app.config.getConfigFromFile('overview-sources').news ?? {} %}
    <div class="section section--default">
        {# @container: the overview's cards per row follow its width (container queries), as in a content row column #}
        <div class="container @container">
            {% include '_site/components/partials/overview.twig' with {
                option: 'news',
                type: 'grid',
                dynamicFill: true,
                relatedBy: (newsSource.related ?? {})|keys|first,
                page: entry,
                title: 'news.entry.relatedTitle'|t('website_name'),
                sizes: craft.trinity.imageSizes('full', 1).sizes,
                siteSettings: siteSettings ?? null,
            } only %}
        </div>
    </div>
{% endcache %}
{% endblock %}