{% extends "_site/_layout" %}

{% block content %}
{% cache globally unless currentUser or craft.app.request.isPreview() %}


    {% include '_site/_snippet/_content/_hero' with {
        heroVariant: 'panel',
        heroImageWidth: 'full',
        heroSide: 'left',
        heroHeight: 'auto',
        heroAlign: 'center',
        heroOverlay: 'gradient'
    } %}

    {% include '_site/_snippet/_content/_contentBuilder'
        with {
        settings : {
            section: 'section',
            container: 'container',
        }
    } %}

{% endcache %}
{% endblock %}
