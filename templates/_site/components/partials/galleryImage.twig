{#
    One image of an image gallery (contentBuilder/columns/imageGallery.twig): the image, optionally a button that opens it in the popup (the gallery's
    images are one group there), and the caption/copyright behind an info button.
    Variables: image, sizes, srcsetSizes, aspectRatio ('' keeps the image's own ratio), popup (bool), group (popup group).
#}
<figure class="relative h-full rounded-images overflow-clip">
    {% if popup %}
        {% set popupSources = [] %}
        {% if image.extension not in ['svg', 'gif'] and image.width %}
            {% set popupWidths = [800, 1200, 1600, 2400]|filter(w => w < image.width)|map(w => w ~ 'w')|merge([image.width ~ 'w']) %}
            {% if craft.app.images.getSupportsAvif() %}
                {% set popupAvif = clone(image) %}
                {% do popupAvif.setTransform({ format: 'avif', quality: 75 }) %}
                {% set popupSources = popupSources|merge([{ type: 'image/avif', srcset: popupAvif.getSrcset(popupWidths) }]) %}
            {% endif %}
            {% set popupImage = clone(image) %}
            {% do popupImage.setTransform({ quality: 80 }) %}
            {% set popupSources = popupSources|merge([{ type: image.mimeType, srcset: popupImage.getSrcset(popupWidths) }]) %}
        {% endif %}
        <button type="button" class="relative block w-full h-full
            before:absolute before:inset-0 before:bg-black/0 hover:before:bg-black/50 focus:before:bg-black/50 before:transition-colors before:duration-200 before:ease-in-out before:z-10
            after:block after:absolute after:top-1/2 after:left-1/2 after:-translate-1/2 after:z-20 after:text-white after:opacity-0 hover:after:opacity-100 focus:after:opacity-100 after:transition-opacity after:duration-200 after:ease-in-out after:shrink-0 after:w-[3rem] after:h-[3rem] after:mask-center after:mask-no-repeat after:mask-contain after:bg-current after:mask-[url(/frontend/icons/zoom-in.svg)]"
            data-modal-image="{{ image.getUrl() }}" data-group="{{ group }}"{% if popupSources|length %} data-modal-srcset="{{ popupSources|json_encode|e('html_attr') }}"{% endif %}
            data-caption="{% if image.imageCaption|length %}{{ image.imageCaption }}{% endif %}{% if image.imageCopyright|length and image.imageCaption|length %}- {% endif %}{% if image.imageCopyright|length %}{{ image.imageCopyright }}{% endif %}">
            <span class="sr-only">{{ 'contentBuilder.columns.image.openPopup'|t("website_name") }}</span>
    {% endif %}

    {{ render_image(image, {
        sizes: sizes,
        srcsetSizes: srcsetSizes,
        aspectRatio: aspectRatio,
        pictureClass: "w-full h-full block",
        imageClass: "w-full h-full object-cover",
    }) }}

    {% if popup %}
        </button>
    {% endif %}

    {% if image.imageCopyright|length or image.imageCaption|length %}
        <figcaption tabindex="0" class="absolute right-2 bottom-2 z-10 group/copyright flex flex-row-reverse items-end">
            <div class="shrink-0 bg-black/70 text-white/70 hover:text-white focus:text-white rounded-full hover:rounded-l-none w-6 h-6 flex justify-center items-center transition duration-300 ease-in-out">
                {{ icon('info', { class: '' }) }}
                <span class="sr-only">{{ "contentBuilder.columns.image.copyrightInfo"|t("website_name") }}</span>
            </div>
            <div class="text-sm text-left leading-tight text-white ml-2 bg-black/70 hidden p-3 group-hover/copyright:block group-focus-within/copyright:block transition duration-300 ease-in-out">
                {% if image.imageCaption|length %}
                    {{ image.imageCaption }}
                {% endif %}
                {% if image.imageCopyright|length %}
                    &copy; {{ image.imageCopyright }}
                {% endif %}
            </div>
        </figcaption>
    {% endif %}
</figure>
