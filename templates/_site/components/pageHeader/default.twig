{#
    The default page header: breadcrumb, the entry's title and intro, its CTAs (if it has a ctas field) and its header image,
    the image in the container on the right, on the light background. A preset of _pageHeader: every variable and block of it
    works here too, e.g.
        {% include '_site/components/pageHeader/default.twig' with { showBreadcrumb: false, headerTextWidth: 'full' } %}
        {% embed '_site/components/pageHeader/default.twig' %}{% block afterTitle %}…{% endblock %}{% endembed %}
#}
{% extends '_site/components/pageHeader/pageHeader.twig' %}

{% set headerTitle = headerTitle ?? entry.title ?? '' %}
{% set headerIntro = headerIntro ?? entry.intro ?? null %}
{% set headerImage = headerImage ?? (entry.headerImage ?? null ? entry.headerImage.one() : null) %}
{% set headerIntroClass = headerIntroClass ?? 'text-xl' %}
{% set headerVariant = headerVariant ?? 'split' %}
{% set headerImageWidth = headerImageWidth ?? 'container' %}
{% set headerSide = headerSide ?? 'left' %}
{% set headerAlign = headerAlign ?? 'top' %}
{% set headerTextWidth = headerTextWidth ?? 'wide' %}
{% set headerSectionClass = headerSectionClass ?? 'section--light' %}
