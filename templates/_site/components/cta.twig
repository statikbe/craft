{#
    One CTA link, rendered by render_ctas() (modules/statik/src/web/twig/CtaExtension.php). Variables:
    link (a Link field value), classes (link style + extra classes), options (see render_ctas())
#}
{% set divClass = options.divClass ?? 'inline-block mt-4 mr-4' %}
{% set divWrapper = options.divWrapper ?? false %}
{% if options.showContrast ?? false %}
    {% set classes = classes ~ ' inverse' %}
{% endif %}

{% if divWrapper %}
<div class="{{ divClass }}">
{% endif %}
  {# Craft's attributes (href with the anchor, target, title, aria-label …), with the style classes added #}
  {% set attributes = link.attributes %}
  {{ tag('a', attributes|merge({
      class: [attributes.class ?? null, classes]|filter|join(' '),
      text: link.label ?: link.url,
  })) }}
{% if divWrapper %}
</div>
{% endif %}
