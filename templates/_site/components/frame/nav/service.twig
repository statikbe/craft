{% set serviceNav = craft.navigate.raw('serviceNav') %}
{% if serviceNav|length %}
	<ul class="flex flex-wrap space-x-4">
		{% for node in serviceNav %}
			<li class="{% if node.classes|length %}{{ node.classes }}{% endif %}">
				<a href="{{ node.url }}" class="text-sm {{ node.active ? 'active text-black underline' : 'text-gray-500 hover-underline' }}" {% if node.blank %} target="_blank" rel="noopener" {% endif %} {% if node.active %}aria-current="page"{% endif %}>{{ node.name }}
				</a>
			</li>
		{% endfor %}
	</ul>
{% endif %}
