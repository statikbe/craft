{% if socialLinks.facebook %}
    <li class="">
        <a href="{{ socialLinks.facebook }}" aria-label="{{ 'content.socialMedia.viewFacebook'|t("website_name") }}" target="_blank" rel="noopener" class="inline-block text-primary hover:text-secondary nav__link--facebook">
            {{ icon('facebook') }} 
            <span class="sr-only">{{ 'content.socialMedia.facebook'|t("website_name") }}</span>
        </a>
    </li>
{% endif %}
