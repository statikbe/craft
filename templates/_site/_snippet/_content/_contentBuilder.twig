{#
	The content rows of a content builder field. Variables: settings (section, container classes) and, for a second content
	builder on the entry, field: the handle of its Matrix field (default contentBuilder). Its width on the page:
	pageWidths.fields in config/trinity.php.

	Spacing between rows with the same background ("Spacing above" on the row, data-row-spacing, see section.css): auto is
	"close" for a row without a title (a follow-up of the row above) and "normal" for a row with one; editors can pick close,
	normal or extra. Rows with another background keep their own padding. autoRowSpacing false in config/trinity.php: auto is
	always "normal".
#}
{% if settings is not defined %}
	{% set settings = [] %}
{% endif %}
{% set builderField = field ?? 'contentBuilder' %}
{% set previousBackground = null %}
{# The row background field and its value when empty or hidden: rowBackgroundField / rowBackgroundDefault in config/trinity.php
   (null: no background field, every row has the same background) #}
{% set backgroundField = craft.trinity.settings.rowBackgroundField %}
{% set backgroundDefault = craft.trinity.settings.rowBackgroundDefault %}
{# The row's "Spacing above" field: rowSpacingField in config/trinity.php (null: always auto) #}
{% set spacingField = craft.trinity.settings.rowSpacingField %}
{# Whether auto looks at the row's titles (close / normal) or is always normal: autoRowSpacing in config/trinity.php #}
{% set autoSpacing = craft.trinity.settings.autoRowSpacing %}

{# contentbuilder-showcase:start — pages generated by `craft statik/contentbuilder` describe each block's variation in an HTML comment before it (not visible, so the page looks identical to a real one). Remove with the `removing-contentbuilder-showcase` skill. #}
{% set isShowcase = craft.statik.isContentbuilderShowcasePage(entry) %}
{# The "Gridbuilder – 2/3 page" and "3/4 page" showcases render the builder at that width, like a page with a sidebar #}
{% set showcasePageWidth = isShowcase ? craft.statik.showcasePageWidth(entry) : null %}
{% set showcaseWidthClass = showcasePageWidth ? ({ 67: 'lg:w-2/3', 75: 'lg:w-3/4' }[(showcasePageWidth * 100)|round] ?? null) : null %}
{# contentbuilder-showcase:end #}

{% for block in (entry[builderField] ?? null) ? entry[builderField].collect() : [] %}

	{# contentbuilder-showcase:start #}
	{% set variationAttr = isShowcase ? 'Contentbuilder variation: "' ~ ('#' ~ loop.index ~ ' · ' ~ craft.statik.contentbuilderShowcaseLabel(block))|e('html') ~ '"' : '' %}
	{% if isShowcase %}
		<!-- {{ variationAttr|raw }} -->
	{% endif %}
	{# contentbuilder-showcase:end #}

	{% if settings.section is defined %}
		{# A hidden "Background color" (its field condition, e.g. on the blocks in a content row) keeps its last value: use the default then #}
		{# Whether the block has the field at all (in its field layout), not its value: an empty background is the default background #}
		{% set hasBackground = backgroundField and block.getFieldLayout().getFieldByHandle(backgroundField) is not null %}
		{% set background = hasBackground
			? (craft.trinity.showsField(block, backgroundField) ? (block[backgroundField] ~ '' ?: backgroundDefault) : backgroundDefault)
			: '' %}
		{% set spacing = null %}
		{# Only content rows: other (older) blocks keep the normal spacing. Craft reports a field that isn't in the block's layout
		   as defined but null, hence the null checks #}
		{% set cellsQuery = block[craft.trinity.settings.cellsField] ?? null %}
		{% if not loop.first and background == previousBackground and cellsQuery is not null %}
			{% set spacing = spacingField ? ((block[spacingField].value ?? 'auto') ?: 'auto') : 'auto' %}
			{% if spacing == 'auto' and not autoSpacing %}
				{% set spacing = 'normal' %}
			{% elseif spacing == 'auto' %}
				{# A visible title in one of its columns starts a new part of the page; a hidden one ("Show title" off) doesn't #}
				{% set cells = cellsQuery.eagerly().all() %}
				{% set spacing = cells|filter(cell => cell.blockTitle is defined and cell.blockTitle|length and craft.statik.showsTitle(cell))|length ? 'normal' : 'close' %}
			{% endif %}
		{% endif %}
		{% set previousBackground = background %}
		<div class="{{ settings.section }} {{ background }}"{% if spacing and spacing != 'normal' %} data-row-spacing="{{ spacing }}"{% endif %}>
	{% endif %}

		{% if settings.container is defined %}
			<div class="{{ settings.container }} @container">
	    {% endif %}

			{# contentbuilder-showcase:start #}{% if showcaseWidthClass %}<div class="{{ showcaseWidthClass }} @container">{% endif %}{# contentbuilder-showcase:end #}
			{% include '_site/_snippet/_content/_blocks/_'~block.type.handle with { settings: settings} %}
			{# contentbuilder-showcase:start #}{% if showcaseWidthClass %}</div>{% endif %}{# contentbuilder-showcase:end #}

		{% if settings.container is defined %}
			</div>
		{% endif %}

	{% if settings.section is defined %}
		</div>
	{% endif %}

{% endfor %}
