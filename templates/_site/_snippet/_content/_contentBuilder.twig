{% if settings is not defined %}
	{% set settings = [] %}
{% endif %}

{# contentbuilder-showcase:start — pages generated by `craft statik/contentbuilder` describe each block's variation in a data attribute (not rendered, so the output stays identical to a real page). Remove with the `removing-contentbuilder-showcase` skill. #}
{% set isShowcase = craft.statik.isContentbuilderShowcasePage(entry) %}
{# The "Gridbuilder – 2/3 page" showcase renders the builder at 2/3 width, like a page with a sidebar #}
{% set showcaseNarrow = isShowcase and craft.statik.isShowcaseNarrowPage(entry) %}
{# contentbuilder-showcase:end #}

{% for block in entry.contentBuilder.collect() %}

	{# contentbuilder-showcase:start #}
	{% set variationAttr = isShowcase ? 'Contentbuilder variation: "' ~ ('#' ~ loop.index ~ ' · ' ~ craft.statik.contentbuilderShowcaseLabel(block))|e('html') ~ '"' : '' %}
	{% if isShowcase %}
		<!-- {{ variationAttr|raw }} -->
	{% endif %}
	{# contentbuilder-showcase:end #}

	{% if settings.section is defined %}
		{# A hidden "Background Color" (its field condition, e.g. on the blocks in a content row) keeps its last value: use the default then #}
		{% set background = block['backgroundColor'] is defined
			? (craft.statik.showsField(block, 'backgroundColor') ? block.backgroundColor : 'section--default')
			: '' %}
		<div class="{{ settings.section }} {{ background }}">
	{% endif %}

		{% if settings.container is defined %}
			<div class="{{ settings.container }} @container">
	    {% endif %}

			{# contentbuilder-showcase:start #}{% if showcaseNarrow %}<div class="lg:w-2/3 @container">{% endif %}{# contentbuilder-showcase:end #}
			{% include '_site/_snippet/_content/_blocks/_'~block.type.handle with { settings: settings} %}
			{# contentbuilder-showcase:start #}{% if showcaseNarrow %}</div>{% endif %}{# contentbuilder-showcase:end #}

		{% if settings.container is defined %}
			</div>
		{% endif %}

	{% if settings.section is defined %}
		</div>
	{% endif %}

{% endfor %}
