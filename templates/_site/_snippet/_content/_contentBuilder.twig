{% if settings is not defined %}
	{% set settings = [] %}
{% endif %}

{# contentbuilder-showcase:start — pages generated by `craft statik/contentbuilder` describe each block's variation in a data attribute (not rendered, so the output stays identical to a real page). Remove with the `removing-contentbuilder-showcase` skill. #}
{% set showcaseSlug = craft.app.config.custom.contentbuilderShowcaseSlug ?? null %}
{% set isShowcase = showcaseSlug and entry.level == 2 and entry.parent.slug == showcaseSlug %}
{# contentbuilder-showcase:end #}

{% for block in entry.contentBuilder.collect() %}

	{# contentbuilder-showcase:start #}
	{% set variationAttr = isShowcase ? ' data-contentbuilder-variation="' ~ ('#' ~ loop.index ~ ' · ' ~ craft.statik.contentbuilderShowcaseLabel(block))|e('html') ~ '"' : '' %}
	{% if isShowcase and settings.section is not defined %}
		<div hidden{{ variationAttr|raw }}></div>
	{% endif %}
	{# contentbuilder-showcase:end #}

	{% if settings.section is defined %}
		<div class="{{ settings.section }} {% if block['backgroundColor'] is defined %}{{ block.backgroundColor }}{% endif %}"{{ variationAttr|raw }}>
	{% endif %}

		{% if settings.container is defined %}
			<div class="{{ settings.container }}">
	    {% endif %}

			{% include '_site/_snippet/_content/_blocks/_'~block.type.handle with { settings: settings} %}

		{% if settings.container is defined %}
			</div>
		{% endif %}

	{% if settings.section is defined %}
		</div>
	{% endif %}

{% endfor %}
