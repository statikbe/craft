{% if block.blockTitle|length %}
    <h2 id="{{ block.blockTitle|slugify }}" class="mb-8">{{ block.blockTitle }}</h2>
{% endif %}

{% set gridClasses = '' %}
{% set cardWidth = 'full' %}
{% switch block.entries|length %}
    {% case 1 %}
        {% set gridClasses = '@sm:w-1/2 mx-auto' %}
        {% set cardWidth = '1/2' %}
    {% case 2 %}
        {% set gridClasses = 'grid grid-cols-1 @sm:grid-cols-2 gap-cards' %}
        {% set cardWidth = '1/2' %}
    {% default %}
        {% set gridClasses = 'grid grid-cols-1 @sm:grid-cols-2 @md:grid-cols-3 gap-cards' %}
        {% set cardWidth = '1/3' %}
{% endswitch %}


<div class="{{ gridClasses }}">
    {% for cardEntry in block.entries.collect() %}
        {% include '_site/_snippet/_item/_card' with { cardWidth: cardWidth, showContrast: block.backgroundColor != "section--default"} %}
    {% endfor %}
</div>
