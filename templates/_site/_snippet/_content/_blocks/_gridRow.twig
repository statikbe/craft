{#
    Content row: 1–3 columns, one cell block per column (left to right = mobile order).
    Widths, image sizes and the 2/3-page context come from modules/statik/src/helpers/GridBuilder.php.
#}
{% set grid = craft.statik.gridRow(block) %}
{% set contrast = block.backgroundColor|length and block.backgroundColor != 'section--default' %}

{# Columns side by side from @sm (halves) or @md (rows with 1/3 columns), see GridBuilder::breakpoint() #}
{% set gridClasses = {
    full: '',
    halves: '@sm:grid-cols-2',
    thirds: '@md:grid-cols-3',
    thirdTwoThirds: '@md:grid-cols-3',
    twoThirdsThird: '@md:grid-cols-3',
}[grid.layout] ?? '' %}
{# A column marked "First on mobile" moves to the top while the columns are stacked (below the same breakpoint).
   Only the visual order changes; the source order (and so screen readers and tabbing) stays left to right. #}
{% set firstOnMobileClass = grid.layout == 'halves' ? '@max-sm:order-first' : '@max-md:order-first' %}
{% set spans = {
    thirdTwoThirds: ['', '@md:col-span-2'],
    twoThirdsThird: ['@md:col-span-2', ''],
}[grid.layout] ?? [] %}

{% apply enkode_emails %}
    {% if grid.columns|length %}
        <div class="grid grid-cols-1 gap-x-column gap-y-section-mobile {{ gridClasses }} {{ { center: 'items-center', end: 'items-end' }[block.gridAlignment.value] ?? 'items-start' }}">
            {% for column in grid.columns %}
                <div class="@container min-w-0 {{ spans[loop.index0] ?? '' }} {{ column.cell.firstOnMobile ? firstOnMobileClass }}">
                    {% include '_site/_snippet/_content/_grid/_' ~ column.cell.type.handle|replace({ cell: '' })|lcfirst with {
                        cell: column.cell,
                        column: column,
                        contrast: contrast,
                    } %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endapply %}
