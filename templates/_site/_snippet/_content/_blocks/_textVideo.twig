{% set inverseClass = block.position == 'right' ? '@md:order-2' : '' %}

{% apply enkode_emails %}
    <div class="grid grid-cols-1 @md:grid-cols-2 gap-x-column gap-y-section-mobile">
        <div class="{{ inverseClass }}">
            {% if block.video|length %}

                {% set embed = craft.videoparser.parse(block.video) %}
                {% set consent = craft.app.request.rawCookies.value('__cookie_consent') %}
                {% if embed %}
                    <figure class="block">
                        <div class="relative bg-center bg-cover bg-black/50 bg-blend-multiply aspect-video rounded-video overflow-clip" data-bg-image id="video-{{block.id}}">
                            {% set image = block.placeholderImage.collect().first() %}
                            {% if image %}
                                {{render_image(image, {
                                    sizes: "(max-width: 479px) 95vw, (min-width: 480px) and (max-width: 659px) 448px, (min-width: 660px) and (max-width: 819px) 314px, (min-width: 820px) and (max-width: 979px) 394px, (min-width: 980px) and (max-width: 1199px) 474px, (min-width: 1200px) 584px",
                                    srcsetSizes: ['448w', '628w', '314w', '394w', '474w', '584w'],
                                    aspectRatio: '16/9',
                                    showPreview: false,
                                })}}
                            {% else %}
                                {% if embed.type == 'youtube' %}
                                    <img src="https://i.ytimg.com/vi/{{embed.id}}/hqdefault.jpg" alt="" class="sr-only" srcset="https://i.ytimg.com/vi/{{embed.id}}/maxresdefault.jpg 1280w, https://i.ytimg.com/vi/{{embed.id}}/sddefault.jpg 640w, https://i.ytimg.com/vi/{{embed.id}}/hqdefault.jpg 480w, https://i.ytimg.com/vi/{{embed.id}}/mqdefault.jpg 320w"
                                         sizes="(max-width: 479px) 95vw, (min-width: 480px) and (max-width: 659px) 448px, (min-width: 660px) and (max-width: 819px) 314px, (min-width: 820px) and (max-width: 979px) 394px, (min-width: 980px) and (max-width: 1199px) 474px, (min-width: 1200px) 584px"/>
                                {% endif %}
                                {% if embed.type == 'vimeo' %}
                                    <img src="https://vumbnail.com/{{embed.id}}.jpg" alt="" class="sr-only"/>
                                {% endif %}
                            {% endif %}
                            <button type="button" class="absolute inset-0"
                                        data-video-toggle="{{embed.embedSrc}}"
                                        data-video-toggle-container="#video-{{block.id}}"
                                        data-video-toggle-show-close-button="false"
                                        {% if consent != "true" and consent != "3" %}disabled{% endif %}>
                                <span class="absolute flex items-center justify-center text-video-button-text -translate-x-1/2 -translate-y-1/2 w-video-button h-video-button rounded-video-button bg-video-button-bg top-1/2 left-1/2">
                                    {{ icon('play-arrow', { class: 'text-video-button' }) }}
                                    <span class="sr-only">{{ 'Play video'|t }}</span>
                                </span>
                            </button>
                            {% if consent != "true" and consent != "3" %}
                                <div class="absolute inset-0 z-10 flex flex-col items-center justify-center p-6 text-center bg-white/95" data-video-consent-blocker>
                                    <h2 class="text-xl font-bold">{{ 'Cookie consent required'|t }}</h2>
                                    <p class="mt-2">{{ 'This video can only be viewed after accepting cookies'|t }}</p>
                                    <div class="flex flex-wrap items-center justify-center gap-2 mt-4 sm:gap-6">
                                        <button type="button" class="btn btn--primary js-cookie-settings">{{ 'Accept cookies'|t }}</button>
                                        <a href="{{ block.video }}" class="underline hover:no-underline" target="_blank" rel="noopener">{{ "Or view this video on "|t }}{{ embed.type }}</a>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                        {% if block.videoCaption|length %}
                            <figcaption class="mt-2 text-sm text-editor italic opacity-70">
                                {{ block.videoCaption }}
                            </figcaption>
                        {% endif %}
                    </figure>
                {% endif %}
            {% endif %}
        </div>
        <div class="">
            {% if block.blockTitle|length %}
                <h2 id="{{ block.blockTitle|slugify }}">{{ block.blockTitle }}</h2>
            {% endif %}
            {% if block.text|length %}
                <div class="text-editor">
                    {{ block.text | raw }}
                </div>
            {% endif %}
            {% if block.cta|length %}
                <div class="flex flex-wrap items-baseline gap-4 mt-6">
                    {{ render_hyper_links(block.cta) | raw }}
                </div>
            {% endif %}
        </div>
    </div>
{% endapply %}
