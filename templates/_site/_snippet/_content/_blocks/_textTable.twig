{% apply enkode_emails %}

<div class="grid grid-cols-1 gap-8 {% if block.tablePosition != "full" and (block.blockTitle|length or block.text|length or block.ctas|length) %}md:grid-cols-2{% endif %}">
    {% if block.blockTitle|length or block.text|length or block.ctas|length %}
    <div class="{% if block.tablePosition == "left" %}md:order-2{% endif %}">
        {% if block.blockTitle|length %}
            <h2 id="{{ block.blockTitle|slugify }}">{{ block.blockTitle }}</h2>
        {% endif %}
        {% if block.text|length %}
            <div class="text-editor">
                {{ block.text }}
            </div>
        {% endif %}
        {% if block.ctas|length %}
            <div class="flex flex-wrap items-baseline gap-4 mt-6">
                {{ render_hyper_links(block.ctas) | raw }}
            </div>
        {% endif %}
    </div>
    {% endif %}
    <div class="order-1">
        <div class="flex justify-center text-editor custom-table md:overflow-x-auto {% if block.mobileTable == "cards" %}mobile-cards{% else %}mobile-scroll{% endif %}">
            {% if block.tableCaption|length %}
                {# Escape the caption and neutralise "\" and "$" so preg_replace does not read them as backreferences #}
                {% set caption = ('<caption>' ~ block.tableCaption|e ~ '</caption>')|replace({'\\': '\\\\', '$': '\\$'}) %}
                {{ block.table|replace('/^(.*?<table\\b[^>]*>)/s', '$1' ~ caption)|raw }}
            {% else %}
                {{ block.table }}
            {% endif %}
        </div>
        {% if block.mobileTable == "scroll" %}
            <div class="mt-2 text-sm md:hidden">
                {{ icon('swipe', { class: '' }) }} 
                {{ "Swipe voor meer"|t }}
            </div>
        {% endif %}
    </div>
</div>
{% endapply %}