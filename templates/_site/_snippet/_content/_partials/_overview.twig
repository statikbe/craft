{#
    An overview of cards (_item/_cards/, the source's card) in a grid or a carrousel, with a title above and a link below. Used by
    the Overview column (_grid/_overview.twig) and on pages that always show one, e.g. related news on a news item
    (_news/_entry.twig).

    Variables:
    - option       the source in config/overview-sources.php: 'entries', 'news', 'calendar', 'knowledgeBase'
    - type         'grid' (default, up to 3 cards) or 'carrousel' (up to 6)
    - chosen       entries picked by hand, shown first in that order
    - dynamicFill  top up with the newest entries of the source's section, up to the limit (without the chosen ones and the page);
                   for a source with fill 'upcoming' (the calendar) the soonest upcoming events, and chosen events that have
                   ended are left out
    - relatedBy    a key of the source's `related` (e.g. 'category'): on a page in that section the fill takes the entries
                   related to the page first, then the newest of the others
    - page         the page the overview is on (to leave it out and to find related entries)
    - title, link  the heading above and the Link field value below (optional)
    - intro        an optional text below the title (HTML)
    - linkPosition 'below' (default: the link centred below the cards) or 'topRight': right of the title and intro once the
                   overview is at least @lg (948px) wide, below the cards on smaller screens
    - cardLayout   'stacked' (default) or 'horizontal': the cards' image left and content right (see _cards/_default.twig), two per
                   row instead of three, and up to 4 cards instead of 3 when the grid fills itself
    - highlightFirst  (grid only) the first card large on the left, spanning two rows; the next two horizontal on
                   the right; 3 cards. One column on small screens
    - sizes        the `sizes` of the column the overview is in, e.g. craft.trinity.imageSizes('full', 1).sizes
    The cards per row use container queries (@sm, @md): put the overview in an @container (a content row column is one).
    - contrast     on a coloured background (cards in their contrast style)
    - siteSettings the site's fallback image for cards without one (set in _layout.twig)
#}
{% import '_site/_snippet/_macros/_imageSizes' as imageSizes %}

{% set option = option ?? 'entries' %}
{% set type = (type ?? 'grid') == 'carrousel' ? 'carrousel' : 'grid' %}
{% set chosen = chosen ?? [] %}
{% set page = page ?? null %}
{# The most cards "Dynamically fill" makes: one row in a grid, a few slides more in a carrousel #}
{% set highlightFirst = type == 'grid' and (highlightFirst ?? false) %}
{% set horizontal = not highlightFirst and (cardLayout ?? 'stacked') == 'horizontal' %}
{% set limit = type == 'carrousel' ? 6 : (horizontal ? 4 : 3) %}
{% set intro = intro ?? '' %}
{% set hasLink = (link ?? null) and link.url|length %}
{% set linkTop = hasLink and (linkPosition ?? 'below') == 'topRight' %}

{# The sources per "Overview options" value: Entries field, section and order for "Dynamically fill", card and "Related items"
   (config/overview-sources.php) #}
{% set sources = craft.app.config.getConfigFromFile('overview-sources') %}
{% set source = sources[option] ?? sources.entries %}
{% set cardTemplate = '_site/_snippet/_item/_cards/_' ~ source.card %}

{# A source with fill 'upcoming' (the calendar): only events that haven't ended, the chosen ones too, and the fill takes the
   soonest upcoming instead of the newest (craft.statik, modules/statik/src/helpers/Calendar.php) #}
{% set upcoming = (source.fill ?? null) == 'upcoming' %}
{% set cards = upcoming ? chosen|filter(c => craft.statik.isUpcomingEvent(c)) : chosen %}
{% if (source.section ?? null) and (dynamicFill ?? false) and cards|length < limit and craft.app.entries.getSectionByHandle(source.section) %}
    {% set fillCriteria = { section: source.section }|merge((source.orderBy ?? null) ? { orderBy: source.orderBy } : {}) %}
    {% set exclude = cards|map(c => c.id)|merge(page.id ?? null ? [page.id] : []) %}

    {# Related to the page first: only on a page in this section (where "Related items" is shown) #}
    {% set relation = (source.related ?? {})[(relatedBy ?? '') ~ ''] ?? null %}
    {% if relation and page and (page.section.handle ?? null) == source.section %}
        {% set relatedCriteria = null %}
        {% if relation.field is defined %}
            {% set targetIds = (page[relation.field] ?? null) is not null ? page[relation.field].ids() : [] %}
            {% set relatedCriteria = targetIds ? { relatedTo: { targetElement: targetIds, field: relation.field } } : null %}
        {% elseif relation.attribute is defined %}
            {% set relatedCriteria = (page[relation.attribute] ?? null) is not null ? { (relation.attribute): page[relation.attribute] } : null %}
        {% endif %}
        {% if relatedCriteria and upcoming %}
            {% set cards = cards|merge(craft.statik.upcomingEvents(craft.entries(fillCriteria|merge(relatedCriteria)), limit - cards|length, exclude)) %}
            {% set exclude = exclude|merge(cards|map(c => c.id)) %}
        {% elseif relatedCriteria %}
            {% set cards = cards|merge(craft.entries(fillCriteria|merge(relatedCriteria)|merge({ id: ['not']|merge(exclude), limit: limit - cards|length })).all()) %}
            {% set exclude = exclude|merge(cards|map(c => c.id)) %}
        {% endif %}
    {% endif %}

    {# The newest (or soonest upcoming) of the others, also when there are too few related ones #}
    {% if cards|length < limit and upcoming %}
        {% set cards = cards|merge(craft.statik.upcomingEvents(craft.entries(fillCriteria), limit - cards|length, exclude)) %}
    {% elseif cards|length < limit %}
        {% set cards = cards|merge(craft.entries(fillCriteria|merge({ id: ['not']|merge(exclude), limit: limit - cards|length })).all()) %}
    {% endif %}
{% endif %}

{% if cards|length %}
    {% if (title ?? '')|length or intro|length or linkTop %}
        <div class="flex flex-col gap-6 mb-8 {{ linkTop ? '@lg:flex-row @lg:items-end @lg:justify-between' }}">
            {% if (title ?? '')|length or intro|length %}
                <div class="{{ linkTop ? '@lg:w-2/3' }}">
                    {% if (title ?? '')|length %}
                        <h2 id="{{ anchor_id(title) }}" class="{{ intro|length ? '' : 'mb-0' }}">{{ title }}</h2>
                    {% endif %}
                    {% if intro|length %}
                        <div class="text-editor">
                            {{ intro }}
                        </div>
                    {% endif %}
                </div>
            {% endif %}
            {% if linkTop %}
                {# Large screens only; smaller screens get the link below the cards #}
                <div class="hidden @lg:flex @lg:shrink-0 @lg:justify-end">
                    {{ render_ctas(link, { showContrast: contrast ?? false, class: 'btn btn--ghost btn--ext' }) }}
                </div>
            {% endif %}
        </div>
    {% endif %}

    {# Cards per row from 628px (@sm) and 788px (@md) container width, as the image gallery; gap: --spacing-cards (20px).
       Horizontal cards: at most 2 per row, their image is 2/5 of the card once the card is 448px wide. #}
    {% set perRow = horizontal or highlightFirst ? { 0: 1, 628: 2 } : { 0: 1, 628: 2, 788: 3 } %}
    {# Highlight: the first card is a half-width stacked card, the others horizontal (2/5 of a half for their image) #}
    {% set firstSizes = imageSizes.itemSizes(sizes, perRow, 1, 20) %}
    {% set sizes = imageSizes.itemSizes(sizes, perRow, 1, 20) %}
    {% if horizontal %}
        {% set sizes = imageSizes.itemSizes(sizes, { 0: 1, 448: 2.5 }, 1, 0) %}
    {% endif %}
    {# The cards are included with only: siteSettings is the site's fallback image (set in _layout.twig) #}
    {% set cardOptions = {
        siteSettings: siteSettings ?? null,
        showContrast: contrast ?? false,
        horizontal: horizontal,
        sizes: sizes,
        srcsetSizes: imageSizes.srcsetSizes(sizes)|split(','),
    } %}

    {% if type == 'carrousel' %}
        {# As the image gallery's carrousel: the swiper sticks out by the gap on the right, so its 100% is the column + one gap; a slide
           is 100% / per row: the card + the gap as its right padding.
           The slides next to the view stay visible (overflow-visible, clipped by <main>) at half opacity: every slide that isn't fully
           in view (Swiper's swiper-slide-fully-visible, with watchSlidesProgress); only once Swiper runs, so without JS all are shown #}
        <div class="-mr-cards">
            <div class="swiper overflow-visible">
                <div class="swiper-wrapper">
                    {% for cardEntry in cards %}
                        {# h-auto: every slide as high as the highest card #}
                        <div class="swiper-slide h-auto pr-cards pb-2 w-full @sm:w-1/2 {{ horizontal ? '' : '@md:w-1/3' }} transition-opacity duration-300 [.swiper-initialized_&:not(.swiper-slide-fully-visible)]:opacity-50">
                            {% include cardTemplate with cardOptions|merge({ cardEntry: cardEntry }) only %}
                        </div>
                    {% endfor %}
                </div>
                <div class="flex items-center gap-4 pt-4 pr-cards">
                    <button type="button" class="swiper-button-prev shrink-0 disabled:opacity-50">
                        {{ icon('chevron-left', { class: 'text-primary text-3xl' }) }}
                        <span class="sr-only">{{ 'Vorige'|t }}</span>
                    </button>
                    <div class="swiper-pagination grow flex flex-wrap justify-center gap-2
                        [&_.swiper-pagination-bullet]:size-3 [&_.swiper-pagination-bullet]:rounded-full [&_.swiper-pagination-bullet]:bg-primary/25 [&_.swiper-pagination-bullet]:cursor-pointer [&_.swiper-pagination-bullet]:transition-colors
                        [&_.swiper-pagination-bullet:hover]:bg-primary/50 [&_.swiper-pagination-bullet-active]:bg-primary!"></div>
                    <button type="button" class="swiper-button-next shrink-0 ml-auto disabled:opacity-50">
                        {{ icon('chevron-right', { class: 'text-primary text-3xl' }) }}
                        <span class="sr-only">{{ 'Volgende'|t }}</span>
                    </button>
                </div>
            </div>
        </div>
    {% elseif highlightFirst %}
        {% set restSizes = imageSizes.itemSizes(firstSizes, { 0: 1, 448: 2.5 }, 1, 0) %}
        <div class="grid grid-cols-1 @sm:grid-cols-2 gap-cards">
            {% for cardEntry in cards %}
                {% if loop.first %}
                    <div class="@sm:row-span-2">
                        {% include cardTemplate with cardOptions|merge({ cardEntry: cardEntry, horizontal: false, sizes: firstSizes, srcsetSizes: imageSizes.srcsetSizes(firstSizes)|split(',') }) only %}
                    </div>
                {% else %}
                    {% include cardTemplate with cardOptions|merge({ cardEntry: cardEntry, horizontal: true, sizes: restSizes, srcsetSizes: imageSizes.srcsetSizes(restSizes)|split(',') }) only %}
                {% endif %}
            {% endfor %}
        </div>
    {% else %}
        {# 1, 2 (@sm) or 3 (@md) per row; an incomplete last row is left aligned. The cards of a row are equally high. #}
        <div class="grid grid-cols-1 @sm:grid-cols-2 {{ horizontal ? '' : '@md:grid-cols-3' }} gap-cards">
            {% for cardEntry in cards %}
                {% include cardTemplate with cardOptions|merge({ cardEntry: cardEntry }) only %}
            {% endfor %}
        </div>
    {% endif %}

    {% if hasLink %}
        <div class="mt-8 flex justify-center {{ linkTop ? '@lg:hidden' }}">
            {{ render_ctas(link, { showContrast: contrast ?? false, class: 'btn btn--ghost btn--ext' }) }}
        </div>
    {% endif %}
{% endif %}
