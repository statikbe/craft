{#
    "Page with sidebar": the content builder at 2/3 next to a sidebar from lg (980px) on, stacked below that.
    The entry type is listed in config/custom.php → contentBuilderNarrow, so grid rows follow the 2/3 rules
    (no 1/3 columns, cell types checked against their width on the page, image sizes; see GridBuilder::NARROW_FROM_VIEWPORT).
#}
<div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-3 lg:gap-x-column">
        <div class="lg:col-span-2 min-w-0">
            {% include '_site/_snippet/_content/_contentBuilder' with {
                settings: {
                    section: 'section section--in-column',
                    container: '',
                }
            } %}
        </div>
        <aside class="section section--in-column">
            {% include '_site/_snippet/_nav/_subNavigation' %}
            {% if entry.sidebarText|length or entry.sidebarCtas|length %}
                <div class="mt-8 first:mt-0">
                    {% if entry.sidebarText|length %}
                        <div class="text-editor">
                            {{ entry.sidebarText }}
                        </div>
                    {% endif %}
                    {% if entry.sidebarCtas|length %}
                        <div class="flex flex-wrap items-baseline gap-4 mt-6">
                            {{ render_hyper_links(entry.sidebarCtas) | raw }}
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </aside>
    </div>
</div>
