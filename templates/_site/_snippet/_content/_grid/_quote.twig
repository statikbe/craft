<div class="w-full @lg:w-8/12 mx-auto">
    <div class="flex flex-wrap @sm:gap-y-6 @sm:flex-nowrap items-center">
        {% set authorImage = cell.authorImage.eagerly().one() %}
        {% if authorImage %}
            <div class="max-w-[100px] @sm:max-w-[200px] w-full rounded-quote-image overflow-clip">
                {{ render_image(authorImage, {
                    sizes: "200px",
                    aspectRatio: '1/1',
                    srcsetSizes: ['200w'],
                    avifQuality: 80,
                    pictureClass: "w-full"
                }) }}
            </div>
        {% endif %}
        <div class="isolate relative @sm:pl-12 mt-10 before:content-['“'] before:absolute before:-top-10 before:-left-6 @sm:before:left-4 before:-z-10 before:text-quote-accent before:opacity-30 before:text-[12rem] before:leading-[12rem] before:pointer-events-none">
            <blockquote>
                {% if cell.text|length %}
                    <div class="text-2xl @md:text-4xl text-quote font-bold font-accent">
                        {{ cell.text }}
                    </div>
                {% endif %}
                {% if cell.writer|length %}
                    <footer class="mt-2 italic text-base">{{ cell.writer }}</footer>
                {% endif %}
            </blockquote>
            {% if cell.cta|length %}
                <div class="mt-4">
                    {{ render_hyper_links(cell.cta) | raw }}
                </div>
            {% endif %}
        </div>
    </div>
</div>
