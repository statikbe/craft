{# FAQ column: a title (anchor, "Show title" off = only for screen readers), then the questions as an accordion. The
   questions (<summary>) aren't headings, so headings in the answers start at H3 under the title. #}
{% if (cell.blockTitle ?? '')|length %}
    {% include '_site/_snippet/_content/_partials/_textColumn' with {
        title: cell.blockTitle,
        hideTitle: not craft.statik.showsTitle(cell),
        text: '',
        ctas: [],
        headingTag: headingTag ?? 'h2',
        class: 'mb-6',
    } only %}
{% endif %}
{% set faqs = cell.faqBlock.all() %}
{% if faqs|length %}
    <div data-accordion-group>
        {% for faq in faqs %}
            <details data-accordion-animation class="[interpolate-size:allow-keywords] details-content:[block-size:0] details-content:transition-all details-content:transition-discrete details-content:duration-300 details-content:ease-in-out open:details-content:[block-size:auto] overflow-clip mb-faq-margin group" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
                <summary class="flex justify-between items-center cursor-pointer px-faq-x py-faq-y font-faq rounded-faq {% if contrast %}bg-faq-bg-contrast text-faq-text-contrast{% else %}bg-faq-bg text-faq-text{% endif %}" id="{{ anchor_id(faq.blockTitle) }}" itemprop="name">
                    {{ faq.blockTitle }}
                    {{ icon('chevron-down', { class: 'text-2xl group-open:rotate-180 transition duration-300 ease-in-out shrink-0' }) }}
                </summary>
                <div class="text-editor p-faq-content" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                    <div itemprop="text">
                        {{ faq.text }}
                    </div>
                </div>
            </details>
        {% endfor %}
    </div>
{% endif %}
