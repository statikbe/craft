{# 1 card column in a 1/2 column, 2 in a 2/3 column, 3 at full width (the cell is its own @container) #}
{% set cards = cell.entries.eagerly().collect() %}
{% set cardWidth = column.width >= 0.6 ? '1/3' : '1/2' %}
{% if cards|length %}
    <div class="grid grid-cols-1 gap-cards {% if cards|length > 1 %}@sm:grid-cols-2{% endif %} {% if cards|length > 2 %}@lg:grid-cols-3{% endif %}">
        {% for cardEntry in cards %}
            {% include '_site/_snippet/_item/_card' with { cardEntry: cardEntry, cardWidth: cardWidth, showContrast: contrast } %}
        {% endfor %}
    </div>
{% endif %}
