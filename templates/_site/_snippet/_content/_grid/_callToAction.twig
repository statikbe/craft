{#
    A copy of the Call To Action block (_blocks/_callToAction.twig) as a cell. Only full rows (minWidthPerType 1 in
    config/trinity.php), so the image sizes are the block's. The row has the background colour: the CTA has the contrast colours
    on a row without one, like the block on the default background.
#}
{% set showContrast = showContrast ?? not contrast %}

{% if cell.blockTitle|length or cell.text|length %}
    <div class="w-full mx-auto overflow-hidden rounded-cta {% if showContrast %}bg-cta-contrast-bg text-cta-contrast-text contrast{% else %}bg-cta-bg text-cta-text{% endif %}">
        <div class="{% if cell.image and cell.image.collect()|length %}grid grid-cols-1 @md:grid-cols-2{% endif %}">
            {% if cell.image and cell.image.collect()|length %}
                {% set image = cell.image.collect().first() ? cell.image.collect().first() : siteSettings.image.one() %}
                <div class="w-full px-4 bg-center bg-cover aspect-video @md:aspect-auto" data-bg-image style="background-position: {% for focalPoint in image.getFocalPoint() %} {{ focalPoint * 100 }}% {% endfor %};">
                    {{render_image(image, {
                        sizes: "(max-width: 479px) 95vw, (min-width: 480px) and (max-width: 659px) 448px, (min-width: 660px) and (max-width: 819px) 628px, (min-width: 820px) and (max-width: 979px) 378px, (min-width: 980px) and (max-width: 1199px) 458px, (min-width: 1200px) 568px",
                        srcsetSizes: ['600w', '1200w'],
                        showPreview: false,
                    })}}
                </div>
            {% endif %}
            <div class="w-full {% if cell.image|length == 0 %}text-center{% endif %}">
                <div class="px-cta-x py-cta-y">
                    {% if cell.blockTitle|length %}
                        <h2 id="{{ anchor_id(cell.blockTitle) }}">{{ cell.blockTitle }}</h2>
                    {% endif %}

                    {% if cell.text|length %}
                        <div class="text-editor w-full {% if not cell.image|length %}@md:w-2/3 mx-auto{% endif %}">
                            {{ cell.text }}
                        </div>
                    {% endif %}

                    {% if cell.ctas|length %}
                        <div class="mt-6">
                            {{ render_ctas(cell.ctas, { showContrast: showContrast }) }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% else %}
    <div class="flex justify-center">
        {{ render_ctas(cell.ctas) }}
    </div>
{% endif %}
