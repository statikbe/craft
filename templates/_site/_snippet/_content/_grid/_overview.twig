{#
    Overview column (full width only, see minWidthPerType in config/trinity.php): cards (_item/_cards/, per option: the source's card) in a grid or a carrousel
    ("Overview type"), with a title above and a link below.
    "Overview options" sets which entries:
    - Entries: the chosen entries, in the editor's order;
    - News, Calendar, Knowledge base: the chosen entries first; "Dynamically fill" adds the newest entries of that section after
      them, up to `limit` cards (without the chosen ones and the page itself).
    Fields of the other options are hidden by their conditions, Trinity empties them, so they come in empty here.
#}
{% import '_site/_snippet/_content/_grid/_imageGallery' as gallery %}

{% set option = cell.overviewOptions.value ?? 'entries' %}
{% set type = cell.overviewType.value ?? 'grid' %}
{# The most cards "Dynamically fill" makes: one row in a grid, a few slides more in a carrousel #}
{% set limit = type == 'carrousel' ? 6 : 3 %}

{# Per option: the Entries field, the section that "Dynamically fill" takes the newest entries from (with its order), and the card
   (_item/_cards/_<card>) #}
{% set sources = {
    entries: { field: 'entries', card: 'default' },
    news: { field: 'newsEntries', section: 'news', orderBy: 'postDate DESC', card: 'news' },
    calendar: { field: 'calendarEntries', section: 'calendar', orderBy: 'postDate DESC', card: 'calendar' },
    knowledgeBase: { field: 'knowledgeBaseEntries', section: 'knowledgeBase', orderBy: 'postDate DESC', card: 'knowledgeBase' },
} %}
{% set source = sources[option] ?? sources.entries %}
{% set cardTemplate = '_site/_snippet/_item/_cards/_' ~ source.card %}

{# Craft reports a field that isn't in the layout as defined but null #}
{% set cards = (cell[source.field] ?? null) is not null ? cell[source.field].eagerly().all() : [] %}
{% if (source.section ?? null) and cell.dynamicFill and cards|length < limit and craft.app.entries.getSectionByHandle(source.section) %}
    {% set cards = cards|merge(craft.entries()
        .section(source.section)
        .id(['not']|merge(cards|map(c => c.id))|merge(entry.id ?? null ? [entry.id] : []))
        .orderBy(source.orderBy)
        .limit(limit - cards|length)
        .all()) %}
{% endif %}

{% if cards|length %}
    {% if cell.blockTitle|length %}
        <h2 id="{{ anchor_id(cell.blockTitle) }}">{{ cell.blockTitle }}</h2>
    {% endif %}

    {# Cards per row from 628px (@sm) and 788px (@md) container width, as the image gallery; gap: --spacing-cards (20px) #}
    {% set perRow = { 0: 1, 628: 2, 788: 3 } %}
    {% set sizes = gallery.gallerySizes(column.sizes, perRow, 1, 20) %}
    {# The cards are included with only: siteSettings is the site's fallback image (set in _layout.twig) #}
    {% set cardOptions = {
        siteSettings: siteSettings ?? null,
        showContrast: contrast,
        sizes: sizes,
        srcsetSizes: gallery.srcsetSizes(sizes)|split(','),
    } %}

    {% if type == 'carrousel' %}
        {# As the image gallery's carrousel: the swiper sticks out by the gap on the right, so its 100% is the column + one gap; a slide
           is 100% / per row: the card + the gap as its right padding.
           The slides next to the view stay visible (overflow-visible, clipped by <main>) at half opacity: every slide that isn't fully
           in view (Swiper's swiper-slide-fully-visible, with watchSlidesProgress); only once Swiper runs, so without JS all are shown #}
        <div class="-mr-cards">
            <div class="swiper overflow-visible">
                <div class="swiper-wrapper">
                    {% for cardEntry in cards %}
                        {# h-auto: every slide as high as the highest card #}
                        <div class="swiper-slide h-auto pr-cards pb-2 w-full @sm:w-1/2 @md:w-1/3 transition-opacity duration-300 [.swiper-initialized_&:not(.swiper-slide-fully-visible)]:opacity-50">
                            {% include cardTemplate with cardOptions|merge({ cardEntry: cardEntry }) only %}
                        </div>
                    {% endfor %}
                </div>
                <div class="flex items-center gap-4 pt-4 pr-cards">
                    <button type="button" class="swiper-button-prev shrink-0 disabled:opacity-50">
                        {{ icon('chevron-left', { class: 'text-primary text-3xl' }) }}
                        <span class="sr-only">{{ 'Vorige'|t }}</span>
                    </button>
                    <div class="swiper-pagination grow flex flex-wrap justify-center gap-2
                        [&_.swiper-pagination-bullet]:size-3 [&_.swiper-pagination-bullet]:rounded-full [&_.swiper-pagination-bullet]:bg-primary/25 [&_.swiper-pagination-bullet]:cursor-pointer [&_.swiper-pagination-bullet]:transition-colors
                        [&_.swiper-pagination-bullet:hover]:bg-primary/50 [&_.swiper-pagination-bullet-active]:bg-primary!"></div>
                    <button type="button" class="swiper-button-next shrink-0 ml-auto disabled:opacity-50">
                        {{ icon('chevron-right', { class: 'text-primary text-3xl' }) }}
                        <span class="sr-only">{{ 'Volgende'|t }}</span>
                    </button>
                </div>
            </div>
        </div>
    {% else %}
        {# 1, 2 (@sm) or 3 (@md) per row; an incomplete last row is left aligned. The cards of a row are equally high. #}
        <div class="grid grid-cols-1 @sm:grid-cols-2 @md:grid-cols-3 gap-cards">
            {% for cardEntry in cards %}
                {% include cardTemplate with cardOptions|merge({ cardEntry: cardEntry }) only %}
            {% endfor %}
        </div>
    {% endif %}

    {% if cell.linkField and cell.linkField.url|length %}
        <div class="mt-8 flex justify-center">
            {{ render_ctas(cell.linkField, { showContrast: contrast, class: 'btn btn--ghost btn--ext' }) }}
        </div>
    {% endif %}
{% endif %}
