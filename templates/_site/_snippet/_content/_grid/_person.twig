{#
    Person column (at most 1/2 of the page, see maxWidthPerType in config/trinity.php): the chosen person's card (_cards/_person),
    as wide as the column. At half the page the photo goes left and the details right (from @xs, 448px, of the column; stacked
    below that, e.g. on mobile); narrower columns stack.
#}
{% import '_site/_snippet/_macros/_imageSizes' as imageSizes %}

{% set person = (cell.person ?? null) is not null ? cell.person.eagerly().one() : null %}
{% if person %}
    {% set horizontal = column.width > 0.49 and column.width < 0.51 %}
    {# Horizontal: the photo is 2/5 of the column from 448px (the column's width / 2.5, no gap) #}
    {% set sizes = horizontal ? imageSizes.itemSizes(column.sizes, { 0: 1, 448: 2.5 }, 1, 0) : column.sizes %}
    {% include '_site/_snippet/_item/_cards/_person' with {
        person: person,
        showContrast: contrast,
        horizontal: horizontal,
        sizes: sizes,
        srcsetSizes: horizontal ? imageSizes.srcsetSizes(sizes)|split(',') : column.srcsetSizes,
    } only %}
{% endif %}
