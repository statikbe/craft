{#
    Team column (full width only, see minWidthPerType in config/trinity.php): a title (anchor) and text, then a card per person
    (_cards/_person): the chosen team members in their order, or, when none are chosen, everyone in the Team section in the order
    of its structure. "Columns" (teamColumns): 2, 3 or 4 per row at full width (fewer on narrow screens; 4 from @xl, the full
    container on large screens). With 2 the cards are about
    half the page, so they're horizontal (photo left, details right) like the Person column at half the page: each card is its own
    @container, so it switches at 448px of its own width (and stacks on mobile). A person without a photo gets a person icon in its
    place (photoFallback), so the cards in a row stay alike.
#}
{% import '_site/_snippet/_macros/_imageSizes' as imageSizes %}

{# Craft reports a field that isn't in the layout as defined but null #}
{% set chosen = (cell.teamMembers ?? null) is not null ? cell.teamMembers.eagerly().all() : [] %}
{% set people = chosen ?: craft.entries.section('team').all() %}

{% if (cell.blockTitle ?? '')|length or (cell.text ?? '')|length %}
    {% include '_site/_snippet/_content/_partials/_textColumn' with {
        title: cell.blockTitle,
        hideTitle: not craft.statik.showsTitle(cell),
        text: cell.text,
        ctas: [],
        headingTag: headingTag ?? 'h2',
        class: '@lg:w-3/4 mb-8',
    } only %}
{% endif %}

{% if people|length %}
    {# 2 columns: 1, then 2 from @sm; 3 columns: 1, 2 (@sm), 3 (@md); 4 columns: also 4 from @xl (1168px). Gap: --spacing-cards
       (20px). The photos' sizes follow from the column's. Tailwind needs the classes written out in full. #}
    {% set columns = { '2': 2, '4': 4 }[(cell.teamColumns.value ?? '3') ~ ''] ?? 3 %}
    {% set perRow = {
        2: { 0: 1, 628: 2 },
        3: { 0: 1, 628: 2, 788: 3 },
        4: { 0: 1, 628: 2, 788: 3, 1168: 4 },
    }[columns] %}
    {% set sizes = imageSizes.itemSizes(column.sizes, perRow, 1, 20) %}
    {% set horizontal = columns == 2 %}
    {# Horizontal: the photo is 2/5 of the card from 448px (the card's width / 2.5, no gap) #}
    {% set photoSizes = horizontal ? imageSizes.itemSizes(sizes, { 0: 1, 448: 2.5 }, 1, 0) : sizes %}
    {% set gridClass = {
        2: '@sm:grid-cols-2',
        3: '@sm:grid-cols-2 @md:grid-cols-3',
        4: '@sm:grid-cols-2 @md:grid-cols-3 @xl:grid-cols-4',
    }[columns] %}
    <div class="grid grid-cols-1 {{ gridClass }} gap-cards">
        {% for person in people %}
            <div class="@container">
                {% include '_site/_snippet/_item/_cards/_person' with {
                    person: person,
                    showContrast: contrast,
                    horizontal: horizontal,
                    photoFallback: true,
                    sizes: photoSizes,
                    srcsetSizes: imageSizes.srcsetSizes(photoSizes)|split(','),
                } only %}
            </div>
        {% endfor %}
    </div>
{% endif %}
