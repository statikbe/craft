<ul class="flex flex-wrap gap-2">
    <li class="">
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ entry.getUrl() }}" target="_blank" class="" title="{{"Deel op Facebook"|t}}">
            {{ icon('facebook') }} 
            <span class="sr-only">{{ 'Facebook'|t }}</span></a>
    </li>
    <li class="">
        <a href="https://www.linkedin.com/shareArticle?mini=false&url={{ entry.getUrl() }}&title={{ entry.title|replace('&', '%26') }}&summary={{ entry.intro|striptags }}&source={{ systemName }}" target="_blank" class="" title="{{"Deel op LinkedIn"|t}}">
            {{ icon('linkedin') }} 
            <span class="sr-only">{{ 'LinkedIn'|t }}</span>
        </a>
    </li>
    <li class="">
        <a href="https://wa.me/?text={{ entry.getUrl() }}" target="_blank" class="" title="{{"Deel op Whatsapp"|t}}">
            {{ icon('whatsapp') }} 
            <span class="sr-only">{{ 'Whatsapp'|t }}</span>
        </a>
    </li>
    <li class="">
        <a href="mailto:?subject={{ entry.title|replace('&', '%26') }}&body={{ entry.getUrl() }}" target="_blank" class="" title="{{"Deel via Email"|t}}">
            {{ icon('mail') }} 
            <span class="sr-only">{{ 'Email'|t }}</span>
        </a>
    </li>
    <li class="">
        <button data-copy="{{ entry.getUrl() }}" data-copy-feedback="{{"Gecopieerd naar je klembord."|t}}" class="cursor-pointer" title="{{ 'Kopieer link'|t }}">
            {{ icon('clipboard') }} 
            <span class="sr-only">{{ 'Kopieer link'|t }}</span>
        </button>
    </li>
</ul>