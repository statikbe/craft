<footer class="page-footer">
	<div class="py-8 bg-light doormat print:hidden">
		<div class="container">
			<div class="flex flex-wrap -mx-4">
				<div class="w-full px-4 mt-4 sm:w-1/2 md:w-1/3">
					<a href="{{ siteUrl }}" class="">
						<img class="w-full max-w-logo" src="{{baseUrl ~ '/frontend/img/site/logo.svg'}}" alt="{{"Startpagina"|t}}"/>
					</a>
					<h3 class="text-3xl">{{ systemName }}</h3>
					{% if siteSettings.address|length %}
						<div class="mt-6">
							{{ siteSettings.address|nl2br }}
						</div>
					{% endif %}
					{% if siteSettings.mail|length or siteSettings.phone|length %}
						<div class="mt-6 space-y-2">
							{% if siteSettings.mail|length %}
								<div class="">
									{{ icon('envelope') }} 
									<a class="no-underline hover:underline" href="mailto:{{siteSettings.mail}}">{{siteSettings.mail}}</a>
								</div>
							{% endif %}
							{% if siteSettings.phone|length %}
								<div class="">
									{{ icon('phone') }} 
									<a class="no-underline hover:underline" href="tel:{{siteSettings.phone}}">{{siteSettings.phone}}</a>
								</div>
							{% endif %}
						</div>
					{% endif %}

					{% set socialLinks = siteSettings.socialLinks %}
					{% if socialLinks|length and (socialLinks.facebook or  socialLinks.instagram or socialLinks.linkedin or socialLinks.twitter or socialLinks.youtube) %}
						<div class="flex items-center mt-6">
							<div class="mr-2">{{ 'Volg ons: '|t }}</div>
							<ul class="flex space-x-4">
								{% include '_site/_snippet/_content/_socialMedia' with {socialLinks : socialLinks} %}
							</ul>
						</div>
					{% endif %}
				</div>
				<div class="w-full px-4 mt-4 sm:w-1/2 md:w-1/3">
					{% if not isSystemOffline %}
						{% include '_site/_snippet/_nav/_doormat' %}
					{% endif %}
				</div>
				<div class="w-full px-4 mt-4 sm:w-1/2 md:w-1/3"></div>
			</div>
		</div>
	</div>
	<div class="py-6 footer">
		<div class="container">
			<div class="flex flex-wrap justify-between">
				<div class="">
					<span>&copy;
						{{ now|date('Y') }}
						{{ systemName }}
						- {{ "Built with"|t }}
						<span class="sr-only">
							love
						</span>
						{{ icon('heart', { class: 'text-primary' }) }}
						{{ "by"|t }}
						<a target="_blank" rel="noopener" href="https://www.statik.be" class="underline hover:no-underline hover:text-primary">Statik</a>{{ ", one of"|t }}
						<a target="_blank" rel="noopener" href="https://www.thekindkids.be" class="underline hover:no-underline hover:text-primary">The Kind Kids</a>
					</span>
				</div>
				<div class="pt-4 xs:pt-0 print:hidden">
					<ul class="flex-wrap space-y-1 xs:space-y-0 xs:space-x-4 xs:flex">
						{% if cookiePolicy %}
							<li>
								<button type="button" class="underline js-cookie-settings hover:no-underline">{{ 'Cookie-instellingen'|t }}</button>
							</li>
							<li class="">
								<a href="{{ cookiePolicy.url }}" class="underline hover:no-underline">{{ cookiePolicy.title }}</a>
							</li>
						{% endif %}
						{% if privacyPolicy %}
							<li class="">
								<a href="{{ privacyPolicy.url }}" class="underline hover:no-underline">{{ privacyPolicy.title }}</a>
							</li>
						{% endif %}
						{% if accessibilityStatement %}
							<li class="">
								<a href="{{ accessibilityStatement.url }}" class="underline hover:no-underline">{{ accessibilityStatement.title }}</a>
							</li>
						{% endif %}
					</ul>
				</div>
			</div>
		</div>
	</div>
</footer>