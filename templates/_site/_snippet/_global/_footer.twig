<footer class="page-footer">
	<div class="py-8 bg-light doormat print:hidden">
		<div class="container">
			<div class="flex flex-wrap -mx-4">
				<div class="w-full px-4 mt-4 sm:w-1/2 md:w-1/3">
					<a href="{{ siteUrl }}" class="">
						<img class="w-full max-w-logo" src="{{baseUrl ~ '/frontend/img/site/logo.svg'}}" alt="{{"global.footer.homepage"|t("website_name")}}"/>
					</a>
					{% if siteSettings.address|length %}
						<address class="mt-6 not-italic">
							{{ siteSettings.address|nl2br }}
						</address>
					{% endif %}
					{% if siteSettings.mail|length or siteSettings.phone|length %}
						<div class="mt-6 space-y-2">
							{% if siteSettings.mail|length %}
								<div class="flex gap-2 items-center">
									{{ icon('envelope') }} 
									<a class="no-underline hover:underline" href="mailto:{{siteSettings.mail}}">{{siteSettings.mail}}</a>
								</div>
							{% endif %}
							{% if siteSettings.phone|length %}
								<div class="flex gap-2 items-center">
									{{ icon('phone') }} 
									<a class="no-underline hover:underline" href="tel:{{siteSettings.phone}}">{{siteSettings.phone}}</a>
								</div>
							{% endif %}
						</div>
					{% endif %}

					{% set socialLinks = siteSettings.socialLinks %}
					{% if socialLinks|length and (socialLinks.facebook or  socialLinks.instagram or socialLinks.linkedin or socialLinks.twitter or socialLinks.youtube) %}
						<div class="flex items-center mt-6 gap-2">
							<div class="">{{ 'global.footer.followUs'|t("website_name") }}</div>
							<ul class="flex gap-2">
								{% include '_site/_snippet/_content/_socialMedia' with {socialLinks : socialLinks} %}
							</ul>
						</div>
					{% endif %}
				</div>
				<div class="w-full px-4 mt-4 sm:w-1/2 md:w-1/3">
					{% if not systemOffline %}
						{% include '_site/_snippet/_nav/_doormat' %}
					{% endif %}
				</div>
				<div class="w-full px-4 mt-4 sm:w-1/2 md:w-1/3"></div>
			</div>
		</div>
	</div>
	<div class="py-4 footer">
		<div class="container">
			<div class="flex flex-wrap justify-between text-sm">
				<div class="">
					<span>&copy;
						{{ now|date('Y') }}
						{{ systemName }}
						- {{ "global.footer.builtWith"|t("website_name") }}
						<span class="sr-only">
							{{ "global.footer.love"|t("website_name") }}
						</span>
						{{ icon('heart', { class: 'text-primary' }) }}
						{{ "global.footer.by"|t("website_name") }}
						<a target="_blank" rel="noopener" href="https://www.statik.be" class="underline hover:no-underline hover:text-primary">Statik</a>{{ "global.footer.oneOf"|t("website_name") }}
						<a target="_blank" rel="noopener" href="https://www.thekindkids.be" class="underline hover:no-underline hover:text-primary">The Kind Kids</a>
					</span>
				</div>
				<div class="pt-4 xs:pt-0 print:hidden">
					<ul class="flex-wrap space-y-1 xs:space-y-0 xs:space-x-4 xs:flex">
						{% cache globally using key 'footer-policy-links-' ~ currentSite.id %}
						{% set cookiePage = craft.entries.section('cookiePolicy').one() %}
						{% if cookiePage %}
							<li>
								<button type="button" class="underline js-cookie-settings hover:no-underline">{{ 'global.footer.cookieSettings'|t("website_name") }}</button>
							</li>
							<li class="">
								<a href="{{ cookiePage.url }}" class="underline hover:no-underline">{{ cookiePage.title }}</a>
							</li>
						{% endif %}
						{% set privacyPage = craft.entries.section('privacyPolicy').one() %}
						{% if privacyPage %}
							<li class="">
								<a href="{{ privacyPage.url }}" class="underline hover:no-underline">{{ privacyPage.title }}</a>
							</li>
						{% endif %}
						{% set accessibilityStatement = craft.entries.section('accessibilityStatement').one() %}
						{% if accessibilityStatement %}
							<li class="">
								<a href="{{ accessibilityStatement.url }}" class="underline hover:no-underline">{{ accessibilityStatement.title }}</a>
							</li>
						{% endif %}
						{% endcache %}
					</ul>
				</div>
			</div>
		</div>
	</div>
</footer>