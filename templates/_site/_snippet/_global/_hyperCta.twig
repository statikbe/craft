{% set divClass = options.divClass ?? 'inline-block mt-4 mr-4' %}
{% set divWrapper = options.divWrapper ?? false %}
{% if options.showContrast is defined and options.showContrast %}
    {% set classes = classes ~ ' inverse' %}
{% endif %}


{% if divWrapper %}
<div class="{{ divClass }}">
{% endif %}
  {% if cta.type|split("\\")|last == "Anchor" %}
    <a href="{{ cta.linkValue }}" target="{{ cta.target }}" class="{{ classes }}">{{ cta.text }}</a>
  {% else %}
    {{ cta.getLink({ class: classes}) }}
  {% endif %}
{% if divWrapper %}
</div>
{% endif %}
