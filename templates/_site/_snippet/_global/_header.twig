<header class="page-header">
	<div class="container">
		<div class="flex items-center justify-between md:items-stretch">
			<a href="{{ siteUrl }}" class="">
				{{ svg('@webroot/frontend/img/site/logo.svg')|attr({ class: 'w-full max-w-logo', role: 'img' }) }}
				<span class="sr-only">{{"global.header.homepage"|t("website_name")}}</span>
			</a>

			{% if not systemOffline %}
				<div class="flex-col items-end hidden md:flex">
					<div class="relative flex flex-wrap items-center justify-end py-4 pl-10 min-w-searchbox">
						<div class="flex items-center relative">
							<div class="flex items-center gap-2" id="searchHide">
								<nav class="flex items-center" aria-label="{{ 'global.header.serviceNavLabel'|t("website_name") }}">
									<div class="mr-6">
										{% include '_site/_snippet/_nav/_service.twig' %}
									</div>
									<div class="hidden md:block">
										{% include "_site/_snippet/_nav/_language" %}
									</div>
								</nav>
								<div class="flex items-center">
									<button type="button" class="text-xl flex justify-center items-center cursor-pointer bg-white hover:bg-light transition-colors duration-300 ease-in-out rounded-full w-8 h-8" data-search-trigger="searchForm" data-search-hide="searchHide" data-search-animated>
										<span class="sr-only">{{ 'global.header.search'|t("website_name") }}</span>
										{{ icon('magnify') }}
									</button>
								</div>
							</div>
							{% include "_site/_snippet/_global/_search.twig" %}
						</div>
					</div>
					<nav class="" aria-label="{{ 'global.header.mainNavLabel'|t("website_name") }}">
						{% include '_site/_snippet/_nav/_main.twig' %}
					</nav>
				</div>
				<button type="button" class="text-3xl md:hidden ie-hidden print:hidden" data-flyout="flyout">
					<span class="sr-only">{{"global.header.menu"|t("website_name")}}</span>
					{{ icon('menu') }} 
				</button>
			{% endif %}
		</div>
	</div>
</header>
