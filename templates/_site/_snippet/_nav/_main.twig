{% cache globally using key 'main-nav-' ~ currentSite.id ~ '-' ~ craft.app.language %}
{% set mainNav = craft.navigate.raw('mainNav') %}

{% if mainNav|length %}
	<ul class="flex flex-wrap gap-8">
		{% for node in mainNav %}
			<li class="{% if node.classes|length %}{{ node.classes }}{% endif %}">
				<a href="{{ node.url }}" class="font-bold text-xl hover-underline hover:text-primary {% if node.active %}active{% endif %}" {% if node.blank %} target="_blank" rel="noopener" {% endif %} {% if node.active %}aria-current="page"{% endif %}>
					{{ node.name }}
				</a>
			</li>
		{% endfor %}
	</ul>
{% endif %}
{% endcache %}
