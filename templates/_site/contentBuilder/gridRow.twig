{#
    Content row: 1–3 columns, one cell block per column (left to right; stacked on mobile in that order, unless a column has a "Mobile order").
    Layout, widths, mobile order and image sizes come from the Trinity plugin (craft.trinity.row, settings in config/trinity.php).
#}
{% set grid = craft.trinity.row(block) %}
{% set contrast = block.backgroundColor|length and block.backgroundColor != 'section--default' and craft.trinity.showsField(block, 'backgroundColor') %}

{# Columns side by side once each column can be at least 256px: from @cols-2 (halves) or @cols-3 (rows with 1/3 columns), see
   --container-cols-* in frontend/css/site/main.css and grid.breakpoint. In between, rows with a 1/3 column show two equal
   columns (grid.twoColumnBreakpoint): the third column of thirds wraps below, as a half on the left. #}
{# Trinity 1.3+; older versions have no two-column step #}
{% set twoColumnStep = (grid.twoColumnBreakpoint ?? null) is not null %}
{% set gridClasses = {
    full: '',
    halves: '@cols-2:grid-cols-2 gap-x-column',
    thirds: '@cols-3:grid-cols-3 gap-x-column-thirds',
    thirdTwoThirds: '@cols-3:grid-cols-3 gap-x-column',
    twoThirdsThird: '@cols-3:grid-cols-3 gap-x-column',
}[grid.layout] ?? '' %}
{% if twoColumnStep %}
    {% set gridClasses = '@cols-2:grid-cols-2 ' ~ gridClasses %}
{% endif %}
{# While the columns are stacked (below @cols-2, or @cols-3 without the two-column step), each column takes its position from
   the "Mobile order" field (column.mobileOrder; no classes when every column is on "Auto").
   Only the visual order changes; the source order (and so screen readers and tabbing) stays left to right. #}
{% set mobileOrderClasses = grid.layout == 'halves' or twoColumnStep
    ? { 1: '@max-cols-2:order-1', 2: '@max-cols-2:order-2', 3: '@max-cols-2:order-3' }
    : { 1: '@max-cols-3:order-1', 2: '@max-cols-3:order-2', 3: '@max-cols-3:order-3' } %}
{% set spans = {
    thirdTwoThirds: ['', '@cols-3:col-span-2'],
    twoThirdsThird: ['@cols-3:col-span-2', ''],
}[grid.layout] ?? [] %}

{# Styling hooks for specific combinations, in source order (left to right, not the mobile order):
   [data-row-cells="text image"] (exact combination), [data-row-cells~="video"] (contains a type), [data-row-layout="halves"],
   and per column [data-cell="quote"], e.g. [data-cell="text"]:has(+ [data-cell="image"]) #}
{% set cellTypes = grid.cellTypes %}

{# A row of cards (h3) without a title gets a hidden h2, so the cards don't follow the page title or an unrelated part of the
   page: the Overview's source heading (config/overview-sources.php) or the column type's (rowHeadings in
   config/headings-checker.php). A title before the cards (in an earlier column or the same one, also a hidden one) replaces
   it. Headings Checker plugin. #}
{% set rowHeading = (entry ?? null) ? craft.headingsChecker.rowHeading(entry, block, builderField ?? 'contentBuilder') : null %}

{% apply obfuscate_emails %}
    {% if grid.columns|length %}
        {% if rowHeading %}
            <h2 class="sr-only">{{ rowHeading }}</h2>
        {% endif %}
        <div class="grid grid-cols-1 gap-y-section-mobile {{ gridClasses }} {{ { center: 'items-center', end: 'items-end' }[block.gridAlignment.value] ?? 'items-start' }}" data-row-layout="{{ grid.layout }}" data-row-cells="{{ cellTypes|join(' ') }}">
            {% for column in grid.columns %}
                <div class="@container min-w-0 {{ spans[loop.index0] ?? '' }} {{ mobileOrderClasses[column.mobileOrder] ?? '' }}" data-cell="{{ cellTypes[loop.index0] }}">
                    {% include '_site/contentBuilder/columns/' ~ cellTypes[loop.index0] ~ '.twig' with {
                        cell: column.cell,
                        column: column,
                        contrast: contrast,
                    } %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endapply %}
