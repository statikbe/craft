<div class="w-full @md:w-form">
    {% if block.blockTitle|length or block.text|length %}
        <div class="mb-6">
            {% if block.blockTitle|length %}
                <h2 id="{{ anchor_id(block.blockTitle) }}">{{ block.blockTitle }}</h2>
            {% endif %}
            {% if block.text|length %}
                <div class="">
                    {{ block.text | raw }}
                </div>
            {% endif %}
        </div>
    {% endif %}
    {% set form = block.form.one() %}
    {% if form %}
        <div class="px-form-x py-form-y rounded-form {% if block.backgroundColor != "section--default" %}bg-form-contrast-bg text-form-contrast-text{% else %}bg-form-bg text-form-text{% endif %}">
            {{ craft.formie.renderForm(form) }}
        </div>
    {% endif %}
</div>
