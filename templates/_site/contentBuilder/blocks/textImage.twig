{% set image = block.image.eagerly().one() %}
{% set ctas = block.ctas.all() %}
{% set inverseClass = block.imagePosition == 'right' and image ? '@md:order-2' : '' %}

{% set imageWidth = '@md:col-span-6' %}
{% set textWidth = '@md:col-span-6' %}
{% switch block.textImageWidth %}
    {% case "1/3" %}
        {% set imageWidth = '@md:col-span-4' %}
        {% set textWidth = '@md:col-span-8' %}
    {% case "2/3" %}
        {% set imageWidth = '@md:col-span-8' %}
        {% set textWidth = '@md:col-span-4' %}
    {% case "1/4" %}
        {% set imageWidth = '@md:col-span-3' %}
        {% set textWidth = '@md:col-span-9' %}
{% endswitch %}


{% apply obfuscate_emails %}
    <div class="{% if image %}grid grid-cols-1 @md:grid-cols-12 gap-x-column gap-y-section-mobile{% endif %}">
        {% if image %}
            <div class="{{ imageWidth }} {{ inverseClass }}">
                {{render_image(image, {
                    sizes: "(max-width: 479px) 95vw, (min-width: 480px) and (max-width: 659px) 448px, (min-width: 660px) and (max-width: 819px) 314px, (min-width: 820px) and (max-width: 979px) 394px, (min-width: 980px) and (max-width: 1199px) 474px, (min-width: 1200px) 584px",
                    srcsetSizes: ['448w', '628w', '314w', '394w', '474w', '584w'],
                    pictureClass: "w-full block rounded-image overflow-clip"
                })}}
                {% if image.imageCopyright|length or image.imageCaption|length %}
                    <div class="mt-1 text-sm italic opacity-50">
                        {% if image.imageCaption|length %}
                            {{ image.imageCaption }}
                        {% endif %}
                        {% if image.imageCopyright|length %}
                            &copy; {{ image.imageCopyright }}
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endif %}
        <div class="{% if not image %}@lg:w-3/4 {% else %}{{ textWidth }}{% endif %}">
            {% if block.blockTitle|length %}
                <h2 id="{{ anchor_id(block.blockTitle) }}">{{ block.blockTitle }}</h2>
            {% endif %}
            {% if block.text|length %}
                <div class="text-editor">
                    {{ block.text }}
                </div>
            {% endif %}
            {% if ctas|length %}
                <div class="flex flex-wrap items-baseline gap-4 mt-6">
                    {{ render_ctas(ctas) }}
                </div>
            {% endif %}
        </div>
    </div>
{% endapply %}
