{% extends "_site/_layout" %}

{% set breadcrumbs = entry.ancestors().all()|merge([entry]) %}

{% block content %}
{% cache unless currentUser or craft.app.request.isPreview() %}

    {% include "_site/_snippet/_content/_defaultHeader" %}

    {% if entry.type.handle == 'pageWithSidebar' %}
        {% include '_site/_snippet/_content/_contentWithSidebar' %}
    {% else %}
        {% include '_site/_snippet/_content/_contentBuilder'
            with {
            settings : {
                section: 'section',
                container: 'container',
            }
        } %}
    {% endif %}

{% endcache %}
{% endblock %}
