{# Heading issues widget (modules/statik/src/widgets/HeadingIssues.php): items = [{title, url, site, issues}], total #}
{% if items is empty %}
    <p class="light">{{ 'No pages with heading issues.'|t('site') }}</p>
{% else %}
    <p class="light">{{ '{count, plural, =1{# page has} other{# pages have}} heading issues.'|t('site', { count: total }) }}</p>
    <ul style="list-style: none; padding: 0; margin: 0;">
        {% for item in items %}
            <li style="padding: 8px 0;{% if not loop.first %} border-top: 1px solid var(--hairline-color);{% endif %}">
                <a href="{{ item.url }}"><strong>{{ item.title }}</strong></a>
                {% if multiSite %}<span class="light"> · {{ item.site }}</span>{% endif %}
                <details style="margin-top: 4px;">
                    <summary class="light" style="cursor: pointer;">{{ '{count, plural, =1{# issue} other{# issues}}'|t('site', { count: item.issues|length }) }}</summary>
                    <ul style="list-style: disc; padding-inline-start: 20px; margin-top: 4px;">
                        {% for issue in item.issues %}
                            <li>{{ issue }}</li>
                        {% endfor %}
                    </ul>
                </details>
            </li>
        {% endfor %}
    </ul>
    {% if total > items|length %}
        <p class="light">{{ 'And {count} more. Run {command} for the full list.'|t('site', { count: total - items|length, command: '<code>craft statik/headings</code>' })|raw }}</p>
    {% endif %}
{% endif %}
