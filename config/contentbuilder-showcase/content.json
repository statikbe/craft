            "fields": {
                "blockTitle": "Compare our plans",
                "text": "<p>Every plan includes <strong>hosting, updates and support</strong>. Not sure which one fits? <em>We're happy to help you choose</em> — <a href=\"https://www.thekindkids.be\">get in touch</a>.</p>",
