        "faq": {
            "fields": {
                "blockTitle": "Frequently asked questions",
                "text": "<p>Can't find your answer here? <strong>Feel free</strong> to <a href=\"https://www.thekindkids.be\">contact us</a>, <em>we're happy to help</em>.</p>",
                "ctas": [
