            "fields": {
                "blockTitle": "Ready to get started?",
                "text": "<p>Get in touch and we will plan a <strong>first meeting</strong> to talk about <em>your project</em>. Or <a href=\"https://www.thekindkids.be\">read about how we work</a> first.</p>",
