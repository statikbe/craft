        "textColumns": {
            "fields": {
                "textColumnBlocks": [
                    {
                        "blockTitle": "Our mission",
                        "text": "<p>We believe in websites that are <strong>accessible to everyone</strong>, <em>fast</em> and <a href=\"https://www.thekindkids.be\">easy to maintain</a>.</p>",
                        "ctas": [
                            {
                                "type": "url",
                                "value": "https://www.statik.be",
                                "text": "About us",
                                "fields": {
                                    "ctaFieldLinkLayouts": "btn btn--secondary"
                                }
                            }
                        ]
                    },
                    {
                        "blockTitle": "Our approach",
                        "text": "<p>We start from <strong>your goals and users</strong>, and work in <em>short iterations</em> with <a href=\"https://www.thekindkids.be\">regular feedback</a>.</p>",
                        "ctas": [
                            {
                                "type": "url",
                                "value": "https://www.statik.be",
                                "text": "How we work",
                                "fields": {
                                    "ctaFieldLinkLayouts": "btn btn--secondary"
                                }
                            }
                        ]
                    },
                    {
                        "blockTitle": "Our team",
                        "text": "<p>A <strong>multidisciplinary team</strong> of designers, developers and strategists, <em>close to you</em> and <a href=\"https://www.thekindkids.be\">always reachable</a>.</p>",
                        "ctas": [
                            {
                                "type": "url",
                                "value": "https://www.statik.be",
                                "text": "Meet the team",
                                "fields": {
                                    "ctaFieldLinkLayouts": "btn btn--secondary"
                                }
                            }
                        ]
                    }
                ]
            }
