                        }
                    ]
                ],
                "faqBlock": [
                    {
                        "blockTitle": "How long does a project take?",
                        "text": "<p>Most websites go live within <strong>three to six months</strong>, <em>depending on the scope</em>. <a href=\"https://www.thekindkids.be\">See our approach</a>.</p>"
                    },
                    {
                        "blockTitle": "Can I manage the content myself?",
                        "text": "<p><strong>Yes.</strong> Every site comes with a user-friendly CMS and <em>a short training</em>. <a href=\"https://www.thekindkids.be\">Learn more</a>.</p>"
                    },
                    {
                        "blockTitle": "Do you also offer hosting?",
                        "text": "<p>We host and maintain the sites we build, <strong>including updates</strong> and <em>backups</em>. <a href=\"https://www.thekindkids.be\">Read about our support</a>.</p>"
                    }
                ]
            }
        },
        "form": {
            "fields": {
                "blockTitle": "Get in touch",
                "text": "<p>Fill in the form and we will get back to you within <strong>two working days</strong>. <em>Prefer a call?</em> <a href=\"https://www.thekindkids.be\">Find our phone number</a>.</p>",
