{
    "compilerOptions": {
        "moduleResolution": "bundler",
        "outDir": "./dist/",
        "sourceMap": true,
        "strict": false,
        "module": "esnext",
        "target": "es2020",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "allowJs": true,
        "types": ["vite/client"]
    },
    "include": ["./**/*"]
}
